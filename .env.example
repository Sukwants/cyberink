NODE_ENV=development
HOST=127.0.0.1
# Comma-separated IP addresses of trusted reverse proxies; empty disables proxy trust.
TRUST_PROXY=
HTTP_PORT=3000
SMTP_PORT=2525
MAIL_DOMAINS=example.test
MAX_MESSAGE_BYTES=10485760
STORAGE_DIR=.data/mail
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cyberink
DB_USER=cyberink
DB_PASSWORD=replace-with-project-password
RELAY_HOST=smtp.example.com
RELAY_PORT=465
RELAY_SECURE=true
RELAY_USER=your-relay-account
RELAY_PASSWORD=your-relay-password
